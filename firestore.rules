        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'name', 'projectType', 'entity', 'paclApplicable', 'pgilApplicable',
          'departmentId', 'departmentName', 'budgetCategory', 'strategicInitiative',
          'campaignType', 'costCentre', 'fundingSource', 'targetAudience', 'expectedROI',
          'kpiTarget', 'projectOwner', 'projectManager', 'vendor', 'vendorId', 'startDate',
          'expectedCompletionDate', 'actualCompletionDate', 'endDate', 'description',
          'status', 'originalBudget', 'approvedBudget', 'revisedBudget', 'budget', 'spent',
          'actualSpend', 'committedSpend', 'remaining', 'remainingBudget',
          'utilizationPercent', 'progressPercent', 'totalBudget', 'paclAllocation',
          'pgilAllocation', 'paclActual', 'pgilActual', 'notes', 'attachedDocuments', 'syncedAt'
