    }

    // Audit Trail Collection (Strictly Append-Only / Immutable)
    match /auditTrail/{auditId} {
      allow get: if isValidId(auditId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(auditId) && isValidAuditTrail(incoming()) &&
        incoming().id == auditId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update, delete: if false;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) &&
        incoming().id == notificationId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isRead', 'title', 'message', 'severity', 'syncedAt'
        ]);
      allow delete: if isValidId(notificationId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
    }

    // Archive Collection
    match /archive/{archiveId} {
      allow get: if isValidId(archiveId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(archiveId) && isValidArchiveItem(incoming()) &&
        incoming().id == archiveId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(archiveId) && isValidArchiveItem(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'reason', 'description', 'syncedAt'
        ]);
      allow delete: if isValidId(archiveId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
    }

    // Official Manuals Collection
    match /officialManuals/{manualId} {
      allow get: if isValidId(manualId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(manualId) && isValidOfficialManual(incoming()) &&
        incoming().id == manualId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(manualId) && isValidOfficialManual(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'version', 'title', 'lastUpdated', 'uploadedBy', 'fileType',
          'fileName', 'fileSize', 'downloadUrl', 'dataUrl', 'isOfficial', 'notes', 'syncedAt'
        ]);
      allow delete: if isValidId(manualId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
    }
  }
}
