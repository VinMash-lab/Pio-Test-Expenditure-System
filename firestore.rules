    // Departments Collection
    match /departments/{departmentId} {
      allow get: if isValidId(departmentId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(departmentId) && isValidDepartment(incoming()) &&
        incoming().id == departmentId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(departmentId) && isValidDepartment(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
