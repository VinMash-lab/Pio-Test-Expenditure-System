    // Import History Collection
    match /importHistory/{importId} {
      allow get: if isValidId(importId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(importId) && isValidImportHistory(incoming()) &&
        incoming().id == importId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(importId) && isValidImportHistory(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
