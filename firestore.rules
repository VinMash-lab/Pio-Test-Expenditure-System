        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'expenseId', 'date', 'expenseDate', 'paymentMethod', 'legalEntity', 'quarter',
          'departmentId', 'departmentName', 'budgetId', 'projectId', 'projectName',
          'campaignName', 'strategicInitiative', 'costCentre', 'fundingSource', 'activity',
          'supplierId', 'supplierName', 'category', 'description', 'invoiceNumber',
          'purchaseOrder', 'amount', 'vatAmount', 'totalAmount', 'paymentStatus',
          'sharedGroupId', 'allocationMethod', 'paclSharePercent', 'pgilSharePercent',
          'receiptFileName', 'receiptFileUrl', 'remarks', 'isBudgetExceeded',
          'requiresAuthorization', 'authorizedBy', 'syncedAt'
        ]);
      allow delete: if isValidId(expenditureId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
