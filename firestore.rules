      allow create: if isVerified() && isValidId(lpoId) && isValidLPO(incoming()) &&
        incoming().id == lpoId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(lpoId) && isValidLPO(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lpoNumber', 'lpoDate', 'legalEntity', 'supplierId', 'supplierName',
          'projectId', 'projectName', 'budgetId', 'budgetCode', 'budgetCategory',
          'departmentId', 'departmentName', 'description', 'lpoAmount', 'amountBeforeVat',
          'vatAmount', 'totalLpoValue', 'totalLpoAmount', 'currency', 'lpoStatus',
          'status', 'expectedDeliveryDate', 'invoiceStatus', 'paymentStatus',
          'relatedInvoice', 'documentId', 'documentFileName', 'documentDataUrl',
          'remarks', 'updatedAt', 'syncedAt'
        ]);
      allow delete: if isValidId(lpoId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
