        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'contactPerson', 'phone', 'email', 'pin', 'address',
          'servicesOffered', 'status', 'totalPaid', 'rating', 'category', 'syncedAt'
        ]);
      allow delete: if isValidId(supplierId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
    }

    // LPOs Collection
    match /lpos/{lpoId} {
