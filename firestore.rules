          'lpoNumber', 'lpoId', 'projectId', 'projectName', 'legalEntity',
          'invoiceDate', 'dueDate', 'amountBeforeVat', 'vatAmount', 'totalAmount',
          'currency', 'paymentStatus', 'paymentDate', 'description', 'notes',
          'documentId', 'documentFileName', 'documentDataUrl', 'remarks', 'updatedAt', 'syncedAt'
        ]);
      allow delete: if isValidId(invoiceId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
