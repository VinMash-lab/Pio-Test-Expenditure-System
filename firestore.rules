          'lpoNumber', 'invoiceNumber', 'invoiceId', 'paymentMethod', 'bankDetails',
          'requesterName', 'projectId', 'projectName', 'legalEntity', 'requestedAmount',
          'requestDate', 'vatAmount', 'totalAmount', 'currency', 'purpose', 'priority',
          'status', 'paymentDate', 'paymentVoucherFileName', 'approvedBy', 'approvalDate',
          'documentId', 'documentFileName', 'documentDataUrl', 'remarks', 'updatedAt', 'syncedAt'
        ]);
      allow delete: if isValidId(paymentRequestId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
