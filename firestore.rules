      allow update: if isVerified() && isValidId(quotationId) && isValidQuotation(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'quotationNumber', 'vendorId', 'vendorName', 'supplierId', 'supplierName',
          'projectId', 'projectName', 'legalEntity', 'quotationDate', 'validUntil',
          'amountBeforeVat', 'vatAmount', 'totalAmount', 'currency', 'status',
