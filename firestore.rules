    // Documents Collection
    match /documents/{documentId} {
      allow get: if isValidId(documentId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(documentId) && isValidDocument(incoming()) &&
        incoming().id == documentId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(documentId) && isValidDocument(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'docNumber', 'title', 'type', 'category', 'departmentId', 'departmentName',
          'legalEntity', 'projectId', 'projectName', 'budgetId', 'budgetCode',
          'expenditureId', 'expenseCode', 'supplierId', 'supplierName', 'lpoId',
          'lpoNumber', 'fileName', 'fileSize', 'fileType', 'mimeType', 'dataUrl',
          'uploadedBy', 'uploadDate', 'downloadUrl', 'status', 'currentVersion',
          'versions', 'activityLog', 'remarks', 'syncedAt'
        ]);
      allow delete: if isValidId(documentId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
