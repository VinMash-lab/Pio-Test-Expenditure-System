    // Payment Requests Collection
    match /paymentRequests/{paymentRequestId} {
      allow get: if isValidId(paymentRequestId) && (isAdmin() || (isVerified() && existing().ownerId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(paymentRequestId) && isValidPaymentRequest(incoming()) &&
        incoming().id == paymentRequestId && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isVerified() && isValidId(paymentRequestId) && isValidPaymentRequest(incoming()) &&
        incoming().id == existing().id && incoming().ownerId == existing().ownerId &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
